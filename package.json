{
  "name": "quranly",
  "private": true,
  "version": "0.1.0-alpha",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:desktop": "vite build --mode desktop",
    "desktop": "electron .",
    "dist:win": "npm run build:desktop && electron-builder --win nsis --x64 && node scripts/keep-latest-build.cjs",
    "test": "node --test tests/security.test.cjs tests/progress.test.cjs tests/auth-links.test.cjs tests/backup.test.cjs",
    "test:desktop": "playwright test"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/status-bar": "^8.0.3",
    "@supabase/supabase-js": "2.118.0",
    "dompurify": "3.4.17",
    "lucide-react": "^1.21.0",
    "ogl": "^1.0.11",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "oxlint": "^1.69.0",
    "vite": "^8.1.0"
  },
  "description": "Quran reading, recitations and daily practice for Windows",
  "author": "BLUECLOUD",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.bluecloud.quranly",
    "productName": "Quranly",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!dist/**/*.apk",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icons/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Quranly-Setup-${version}-${arch}.${ext}"
    }
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  }
}
